# ── Python / tooling noise ───────────────────────────────────────────────────
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# ── Never commit game assets or archives ─────────────────────────────────────
# (the game itself is the owner's IP; workshop mods live in dist-overlay/
#  with permission assumed for personal use — see dist-overlay/README.md)
uploads/
dist/
save_backup_*/
*.rar
*.zip
*.7z
*.sgr
*.exe
*.dll

# ── EXCEPTION (owner decision, session 10, 2026-10-06) ───────────────────────
# game/ is the owner's game copy, committed ON PURPOSE so future sessions can
# inspect it (game/decoded/ = data.sgr decoded by tools/sgr_extract.py).
# Do NOT delete game/ — the owner (or a later session he asks) removes it after
# the next debug run. See HANDOFF.md §2.
!game/
!game/**

# ── Legacy guards from the abandoned Godot plan (kept just in case) ──────────
*.pck
.godot/
